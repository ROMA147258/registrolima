# ==============================================================================
# SISTEMA DE CONTEO RÁPIDO Y REGISTRO LIMA 2026 — SOMOS PERÚ
# Plantilla Maestra de Variables de Entorno (.env.example)
#
# INSTRUCCIONES:
# 1. Este archivo es solo una plantilla de referencia pública.
# 2. Para configurar el backend, crea un archivo llamado '.env' dentro de /backend
# 3. Para configurar el frontend, crea un archivo llamado '.env' dentro de /frontend
# 4. NUNCA subas archivos '.env' con contraseñas reales al repositorio.
# ==============================================================================

# ==============================================================================
# 1. CONFIGURACIÓN DEL BACKEND (/backend/.env)
# ==============================================================================
PORT=3000
NODE_ENV=development

# Base de Datos Cloud (PostgreSQL Neon con SSL)
DATABASE_URL=postgresql://neondb_owner:TU_PASSWORD_AQUI@ep-super-silence-axywhu8v-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_SERVER=ep-super-silence-axywhu8v-pooler.c-4.us-east-2.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USER=neondb_owner
DB_PASSWORD=TU_PASSWORD_AQUI
DB_SSL=true

# Seguridad & Autenticación JWT
JWT_SECRET=super_secret_jwt_key_somos_peru_2026_conteo_lima

# Credenciales de Supervisores y Administradores
ADMIN_USERNAME=admin
ADMIN_PASSWORD=tu_password_admin

ERIC_USERNAME=eric
ERIC_PASSWORD=tu_password_eric

PAOLA_USERNAME=paola
PAOLA_PASSWORD=tu_password_paola

SUSANA_USERNAME=susana
SUSANA_PASSWORD=tu_password_susana

# URL del Frontend permitida para CORS
FRONTEND_URL=http://localhost:3180

# ==============================================================================
# 2. CONFIGURACIÓN DEL FRONTEND (/frontend/.env)
# ==============================================================================
# Endpoint de la API consumido por la interfaz web Vite
VITE_API_URL=/api
